// ============================================================================
// Neon Drip Coffee — Prisma Schema
// "Fueled by Caffeine, Driven by Code."
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  BARISTA
  ADMIN
}

enum ProductCategory {
  COFFEE
  PASTRY
}

enum RoastLevel {
  LIGHT
  MEDIUM
  DARK
}

enum GrindType {
  WHOLE_BEAN
  ESPRESSO
  FILTER
  FRENCH_PRESS
  MOKA
  NOT_APPLICABLE
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum SubscriptionFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  PAST_DUE
}

enum DeliveryStatus {
  SCHEDULED
  PROCESSING
  SHIPPED
  DELIVERED
  SKIPPED
  FAILED
}

enum PodType {
  INDIVIDUAL
  GROUP
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentProvider {
  STRIPE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  passwordHash     String?
  phone            String?
  image            String?
  role             Role      @default(CUSTOMER)
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  // Id del "Customer" en Stripe — se crea una sola vez por usuario, la
  // primera vez que se suscribe a Bean Deploy, y se reutiliza siempre.
  stripeCustomerId String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  addresses     Address[]
  orders        Order[]
  subscriptions Subscription[]
  reservations  Reservation[]

  @@index([email])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String?
  street    String
  number    String
  city      String
  state     String
  zipCode   String
  country   String   @default("Uruguay")
  latitude  Float?
  longitude Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@index([userId])
}

model Product {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  description    String
  category       ProductCategory
  roastLevel     RoastLevel?
  intensity      Int?
  origin         String?
  tastingNotes   String?
  basePrice      Decimal         @db.Decimal(10, 2)
  imageUrl       String?
  isSubscribable Boolean         @default(false)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  variants               ProductVariant[]
  orderItems             OrderItem[]
  subscriptionDeliveries SubscriptionDelivery[]

  @@index([category])
}

model ProductVariant {
  id        String    @id @default(cuid())
  productId String
  name      String
  grindType GrindType @default(NOT_APPLICABLE)
  weightGr  Int?
  price     Decimal   @db.Decimal(10, 2)
  sku       String    @unique
  stock     Int       @default(0)
  isActive  Boolean   @default(true)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  userId      String
  status      OrderStatus @default(PENDING)
  subtotal    Decimal     @db.Decimal(10, 2)
  total       Decimal     @db.Decimal(10, 2)
  pickupEta   DateTime?
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user    User        @relation(fields: [userId], references: [id])
  items   OrderItem[]
  payment Payment?

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  productId        String
  productVariantId String
  quantity         Int
  unitPrice        Decimal @db.Decimal(10, 2)
  subtotal         Decimal @db.Decimal(10, 2)

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@index([orderId])
}

model SubscriptionPlan {
  id          String                @id @default(cuid())
  name        String                @unique
  description String
  frequency   SubscriptionFrequency
  weightGr    Int
  price       Decimal               @db.Decimal(10, 2)
  isActive    Boolean               @default(true)

  subscriptions Subscription[]
}

model Subscription {
  id                   String              @id @default(cuid())
  userId               String
  planId               String
  addressId            String
  status               SubscriptionStatus  @default(ACTIVE)
  roastPreference      RoastLevel?
  grindPreference      GrindType           @default(WHOLE_BEAN)
  stripeSubscriptionId String?             @unique
  currentPeriodStart   DateTime            @default(now())
  currentPeriodEnd     DateTime
  cancelledAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  user       User                   @relation(fields: [userId], references: [id])
  plan       SubscriptionPlan       @relation(fields: [planId], references: [id])
  address    Address                @relation(fields: [addressId], references: [id])
  deliveries SubscriptionDelivery[]

  @@index([userId])
  @@index([status])
}

model SubscriptionDelivery {
  id             String         @id @default(cuid())
  subscriptionId String
  productId      String?
  status         DeliveryStatus @default(SCHEDULED)
  scheduledFor   DateTime
  shippedAt      DateTime?
  deliveredAt    DateTime?
  trackingCode   String?
  createdAt      DateTime       @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [productId], references: [id])

  @@index([subscriptionId])
}

model CyberPod {
  id         String   @id @default(cuid())
  name       String   @unique
  type       PodType
  capacity   Int
  hourlyRate Decimal  @db.Decimal(10, 2)
  amenities  String[]
  // Ficha técnica completa (texto largo, con saltos de línea) que se
  // muestra en la página de reserva de cada pod. `amenities` sigue siendo
  // la lista corta de viñetas que ya usabas en las cards.
  specsNote  String?
  imageUrl   String?
  isActive   Boolean  @default(true)

  reservations Reservation[]
}

model Reservation {
  id         String             @id @default(cuid())
  userId     String
  cyberPodId String
  status     ReservationStatus  @default(PENDING)
  startTime  DateTime
  endTime    DateTime
  attendees  Int                @default(1)
  totalPrice Decimal            @db.Decimal(10, 2)
  notes      String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  cyberPod CyberPod @relation(fields: [cyberPodId], references: [id])
  payment  Payment?

  @@index([cyberPodId, startTime, endTime])
  @@index([userId])
}

model Payment {
  id                    String          @id @default(cuid())
  orderId               String?         @unique
  reservationId         String?         @unique
  provider              PaymentProvider @default(STRIPE)
  status                PaymentStatus   @default(PENDING)
  amount                Decimal         @db.Decimal(10, 2)
  currency              String          @default("USD")
  stripePaymentIntentId String?         @unique
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  order       Order?       @relation(fields: [orderId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id])
}
